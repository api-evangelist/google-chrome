  "info": {
    "_postman_id": "b263a2d2-c01f-4e0a-8720-02499e5af2f6",
    "name": "Google Chrome Management Telemetry Events API",
    "description": "The Chrome Management API provides programmatic access to manage Chrome browser deployments and ChromeOS devices in enterprise environments. It enables administrators to retrieve telemetry data from managed devices, query information about installed apps and extensions, generate reports on browser and device usage, and manage Chrome policies at scale. The API is part of the Google Workspace Admin suite and requires appropriate admin privileges and OAuth 2.0 authentication scopes.\n\nContact Support:\n Name: Google Chrome Enterprise Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:24:02.000Z",
    "updatedAt": "2026-10-22T01:24:02.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-b263a2d2-c01f-4e0a-8720-02499e5af2f6"
  },
