  "item": [
    {
      "id": "a202b3ba-49ef-4636-8ad4-8519506f0ddc",
      "name": "Telemetry Events",
      "description": {
        "content": "Operations for listing telemetry events from managed ChromeOS devices such as USB peripherals, audio, network state changes, and hardware status events.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2cedbcab-fc6b-46ce-a61c-b9a9970d1057",
          "name": "List telemetry events",
          "request": {
            "name": "List telemetry events",
            "description": {
              "content": "Lists telemetry events for a customer. Events include USB peripherals added or removed, audio severe underrun, network state changes, hardware status changes, and other device-level events. Events are retained for a limited time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "customers",
                ":customerId",
                "telemetry",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "Maximum number of results to return. Maximum value is 1000."
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "Token to specify next page in the result set."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Filter to restrict results. Supports filtering by event type, device, user, and timestamp."
                },
                {
                  "disabled": false,
                  "key": "readMask",
                  "value": "<string>",
                  "description": "Fields to include in the response. Supported event types: audioSevereUnderrunEvent, usbPeripheralsEvent, networkStateChangeEvent, httpsLatencyChangeEvent, wifiSignalStrengthEvent, vpnConnectionStateChangeEvent, appInstallEvent, appUninstallEvent, appLaunchEvent."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "customerId",
                  "description": "(Required) Google Workspace customer ID. Use 'my_customer' to refer to the customer associated with the authenticated admin."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
